<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/qalamix_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo_v31</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/qalamix_splash_bg</item>
        <item name="android:statusBarColor">@color/qalamix_splash_bg</item>
        <item name="android:navigationBarColor">@color/qalamix_splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/qalamix_window_dark</item>
        <item name="android:statusBarColor">@color/qalamix_window_dark</item>
        <item name="android:navigationBarColor">@color/qalamix_window_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
